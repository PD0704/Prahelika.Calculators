@page
@model FinanceModel
@using Prahelika.Calculators.Web.Models
@{
    ViewData["Title"] = "Finance calculators";
}

<h1 class="h2 mb-3">Finance calculators</h1>

<ul class="nav nav-pills mb-4">
    @foreach (var calculation in Enum.GetValues<FinanceCalculation>())
    {
        <li class="nav-item">
            <a class="nav-link @(calculation == Model.Calculation ? "active" : "")"
               asp-page="/Finance" asp-route-calculation="@calculation">@calculation.DisplayName()</a>
        </li>
    }
</ul>

<h2 class="h4">@Model.Calculation.DisplayName()</h2>
<p class="text-muted">@Model.Description</p>

<form method="post" class="row g-3" style="max-width: 32rem">
    <div class="col-12">
        <label asp-for="Amount" class="form-label">@Model.AmountLabel</label>
        <input asp-for="Amount" type="number" step="any" class="form-control" />
    </div>

    @if (Model.Calculation == FinanceCalculation.Roi)
    {
        <div class="col-12">
            <label asp-for="FinalValue" class="form-label">Final value</label>
            <input asp-for="FinalValue" type="number" step="any" class="form-control" />
        </div>
    }
    else
    {
        <div class="col-12">
            <label asp-for="Rate" class="form-label">@Model.RateLabel</label>
            <input asp-for="Rate" type="number" step="any" class="form-control" />
        </div>
    }

    @if (Model.Calculation is FinanceCalculation.SimpleInterest or FinanceCalculation.CompoundInterest)
    {
        <div class="col-12">
            <label asp-for="Years" class="form-label">Time (years)</label>
            <input asp-for="Years" type="number" step="any" class="form-control" />
        </div>
    }

    @if (Model.Calculation is FinanceCalculation.Emi or FinanceCalculation.Amortization or FinanceCalculation.Sip)
    {
        <div class="col-12">
            <label asp-for="Months" class="form-label">Time (months, 1 to 1200)</label>
            <input asp-for="Months" type="number" step="1" class="form-control" />
        </div>
    }

    @if (Model.Calculation == FinanceCalculation.CompoundInterest)
    {
        <div class="col-12">
            <label asp-for="Frequency" class="form-label">Interest is added</label>
            <select asp-for="Frequency" class="form-select">
                <option value="Annually">Annually (1 time a year)</option>
                <option value="SemiAnnually">Semi-annually (2 times a year)</option>
                <option value="Quarterly">Quarterly (4 times a year)</option>
                <option value="Monthly">Monthly (12 times a year)</option>
                <option value="Weekly">Weekly (52 times a year)</option>
                <option value="Daily">Daily (365 times a year)</option>
            </select>
        </div>
    }

    @if (Model.Calculation == FinanceCalculation.Gst)
    {
        <div class="col-12">
            <label asp-for="Mode" class="form-label">The amount</label>
            <select asp-for="Mode" class="form-select">
                <option value="Exclusive">does not include GST (add GST)</option>
                <option value="Inclusive">already includes GST (take GST out)</option>
            </select>
        </div>
    }

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Calculate</button>
        @if (Model.Calculation == FinanceCalculation.Amortization)
        {
            <button type="submit" asp-page-handler="Csv" asp-route-calculation="@Model.Calculation"
                    class="btn btn-outline-secondary ms-2">
                Download CSV
            </button>
        }
    </div>
</form>
<partial name="_Result" model="Model" />

            
@if (Model.ChartJson is not null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted">Balance over time</h2>
            <div style="position: relative; height: 18rem">
                <canvas id="balance-chart" role="img"
                        aria-label="Line chart of the loan balance after each monthly payment. The table above has the same numbers."></canvas>
            </div>

            <h2 class="h6 text-uppercase text-muted mt-4">Principal and interest in each payment</h2>
            <div style="position: relative; height: 18rem">
                <canvas id="split-chart" role="img"
                        aria-label="Stacked area chart of how much of each payment is principal and how much is interest. The table above has the same numbers."></canvas>
            </div>

            <script id="loan-chart-data" type="application/json">@Html.Raw(Model.ChartJson)</script>
        </div>
    </div>
}

@section Scripts {
    @if (Model.ChartJson is not null)
    {
        <script src="~/lib/chart.js/dist/chart.umd.js"></script>
        <script src="~/js/loan-chart.js" asp-append-version="true"></script>
    }
}