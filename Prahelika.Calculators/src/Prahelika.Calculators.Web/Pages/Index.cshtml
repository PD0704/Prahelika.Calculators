@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center my-5">
    <h1 class="display-5">Prahelika Calculators</h1>
    <p class="lead">Basic, scientific and finance calculators, built on a tested .NET library.</p>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Basic</h2>
                <p class="card-text">Add, subtract, multiply, divide, remainder and percentage, with exact decimal arithmetic.</p>
                <a asp-page="/Basic" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Scientific</h2>
                <p class="card-text">Powers, roots, logarithms, trigonometry in degrees or radians, and factorials.</p>
                <a asp-page="/Scientific" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Finance</h2>
                <p class="card-text">Interest, loan EMI and schedules, SIP, ROI and GST.</p>
                <a asp-page="/Finance" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">India finance</h2>
                <p class="card-text">FD, RD, PPF, GST split into CGST and SGST, and an income-tax estimate.</p>
                <a asp-page="/India" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h4 card-title">Loan tools</h2>
                <p class="card-text">Prepay a loan, compare two loans, or find out how much you can borrow.</p>
                <a asp-page="/Loans" class="btn btn-primary">Open</a>
            </div>
        </div>
    </div>
</div>