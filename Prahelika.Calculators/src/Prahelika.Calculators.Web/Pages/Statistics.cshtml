@page
@model StatisticsModel
@{
    ViewData["Title"] = "Statistics calculator";
}

<h1 class="h2 mb-3">Statistics calculator</h1>
<p class="text-muted">Enter a list of numbers to get the mean, median, mode and standard deviation.</p>

<form method="post" class="row g-3" style="max-width: 32rem">
    <div class="col-12">
        <label asp-for="Values" class="form-label">Numbers</label>
        <textarea asp-for="Values" rows="4" class="form-control" placeholder="2, 4, 4, 4, 5, 5, 7, 9"></textarea>
        <div class="form-text">
            Separate the numbers with commas, spaces or new lines. Use a dot for decimals and no thousands
            separators: write 100000, not 1,00,000.
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Calculate</button>
    </div>
</form>
<partial name="_Result" model="Model" />