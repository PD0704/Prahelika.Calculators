<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <title>@ViewData["Title"] - Prahelika.Calculators.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prahelika.Calculators.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Prahelika - Calculators</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Basic">Basic</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Scientific">Scientific</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Finance">Finance</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/India">India</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Loans">Loans</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">More</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Statistics">Statistics</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Units">Units</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Dates">Dates</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Programmer">Programmer</a></li>
                            </ul>
                        </li>
                    </ul>
                    <button type="button" id="theme-toggle" class="btn btn-sm btn-outline-secondary ms-sm-2 my-2 my-sm-0">Theme: Auto</button>
                    <button type="button" id="history-toggle" class="btn btn-sm btn-outline-secondary ms-sm-2 my-2 my-sm-0"
                            data-bs-toggle="offcanvas" data-bs-target="#history-panel" aria-controls="history-panel">
                        History <span id="history-count" class="badge text-bg-secondary" hidden>0</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-body-secondary">
        <div class="container">
            &copy; 2026 Prahelika Calculators - <a href="https://github.com/PD0704/Prahelika.Calculators">Source on GitHub</a>
        </div>
    </footer>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="history-panel" aria-labelledby="history-title">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5" id="history-title">History</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close history"></button>
        </div>
        <div class="offcanvas-body">
            <p class="small text-body-secondary">Your last 20 results. They are saved only in this browser.</p>
            <p id="history-unavailable" class="small text-warning-emphasis" hidden>
                This browser is blocking storage, so results cannot be saved.
            </p>
            <ul id="history-list" class="list-group list-group-flush mb-3"></ul>
            <p id="history-empty" class="text-body-secondary">No results yet. Calculate something and it will appear here.</p>
            <button type="button" id="history-clear" class="btn btn-sm btn-outline-danger" hidden>Clear history</button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/history.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
