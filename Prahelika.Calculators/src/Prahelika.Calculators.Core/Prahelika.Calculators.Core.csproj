<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Prahelika.Calculators</PackageId>
    <Version>1.3.0</Version>
    <Authors>Prahelika Dutta (PD)</Authors>
    <Description>A calculator library for .NET with basic, scientific, finance and India-focused calculators (FD, RD, PPF, GST split, income tax), loan planning tools, and statistics, unit conversion, date and programmer calculators.
    </Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PD0704/Prahelika.Calculators</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>
      calculator;math;finance;scientific;india;gst;emi;income-tax;loan;prepayment;borrowing;statistics;unit-converter;date;binary;hex
    </PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Ship the /// comments inside the package so IntelliSense shows them. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing-comment warnings stay as warnings, because warnings are treated as errors elsewhere. -->
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>

    <!-- Source Link: debugger can download the exact source from GitHub. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
