<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Prahelika.Calculators</PackageId>
    <Version>0.0.1-alpha</Version>
    <Authors>Prahelika Dutta (PD)</Authors>
    <Description>A calculator library for .NET with basic, scientific and finance calculators.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PD0704/Prahelika.Calculators</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>calculator;math;finance;scientific</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
