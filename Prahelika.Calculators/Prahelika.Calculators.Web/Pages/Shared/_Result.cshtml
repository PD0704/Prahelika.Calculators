@model Prahelika.Calculators.Web.Models.CalculatorPageModel

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger mt-4" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Result is { } result)
{
    <div class="card mt-4 border-success">
        <div class="card-body">
            <h2 class="h6 text-success text-uppercase">Result</h2>

            @if (result.Summary is not null)
            {
                <p class="display-6 mb-0 text-break">@result.Summary</p>
            }

            @if (result.Details.Count > 0)
            {
                <dl class="row mb-0">
                    @foreach (var detail in result.Details)
                    {
                        <dt class="col-sm-6">@detail.Key</dt>
                        <dd class="col-sm-6 mb-1">@detail.Value</dd>
                    }
                </dl>
            }

            @if (result.Rows.Count > 0)
            {
                <div class="table-responsive" style="max-height: 24rem">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                @foreach (var column in result.Columns)
                                {
                                    <th class="text-end">@column</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in result.Rows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td class="text-end">@cell</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.Note is not null)
            {
                <p class="small text-muted mt-3 mb-0">@Model.Note</p>
            }
        </div>
    </div>
}