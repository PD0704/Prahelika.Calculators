# Stage 1: build the API project with the full .NET SDK
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY Prahelika.Calculators/ Prahelika.Calculators/
RUN dotnet publish Prahelika.Calculators/src/Prahelika.Calculators.Api/Prahelika.Calculators.Api.csproj --configuration Release --output /app

# Stage 2: run it on the smaller ASP.NET runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app .

# Render sends traffic to port 10000 by default
ENV ASPNETCORE_HTTP_PORTS=10000

# Render handles HTTPS in front of the container. This makes the app trust the "https" it reports,
# so Swagger calls the https address instead of an http one.
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

EXPOSE 10000

ENTRYPOINT ["dotnet", "Prahelika.Calculators.Api.dll"]